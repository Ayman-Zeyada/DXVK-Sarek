#version 450
#extension GL_GOOGLE_include_directive : enable

#include "d3d9_convert_common.h"

layout(
  local_size_x = 8,
  local_size_y = 8,
  local_size_z = 1) in;

layout(binding = 0)
writeonly uniform image2D dst;

layout(binding = 1) uniform usamplerBuffer src;

layout(push_constant)
uniform u_info_t {
  uvec2 extent;
  ivec2 dstOffset;
} u_info;

vec3 decodeRgb565(uint value) {
  uint r = (value >> 11) & 0x1Fu;
  uint g = (value >> 5)  & 0x3Fu;
  uint b = value & 0x1Fu;

  return vec3(
    unormalize(r, 5),
    unormalize(g, 6),
    unormalize(b, 5));
}

vec3 decodeBcColorOpaque(uint color0, uint color1, uint selector) {
  vec3 colors[4];
  colors[0] = decodeRgb565(color0);
  colors[1] = decodeRgb565(color1);
  colors[2] = (2.0 * colors[0] + colors[1]) / 3.0;
  colors[3] = (colors[0] + 2.0 * colors[1]) / 3.0;

  return colors[selector];
}

uint decodeBc3AlphaIndex(uint idx, uint alphaBitsLo, uint alphaBitsHi) {
  uint bitOffset = idx * 3u;
  uint value;

  if (bitOffset < 24u) {
    value = alphaBitsLo >> bitOffset;

    if (bitOffset > 21u)
      value |= alphaBitsHi << (24u - bitOffset);
  } else {
    value = alphaBitsHi >> (bitOffset - 24u);
  }

  return value & 0x7u;
}

float decodeBc3Alpha(uint alpha0, uint alpha1, uint idx) {
  float a0 = unormalize(alpha0, 8);
  float a1 = unormalize(alpha1, 8);

  switch (idx) {
    case 0u: return a0;
    case 1u: return a1;
    default: break;
  }

  if (alpha0 > alpha1) {
    switch (idx) {
      case 2u: return (6.0 * a0 + 1.0 * a1) / 7.0;
      case 3u: return (5.0 * a0 + 2.0 * a1) / 7.0;
      case 4u: return (4.0 * a0 + 3.0 * a1) / 7.0;
      case 5u: return (3.0 * a0 + 4.0 * a1) / 7.0;
      case 6u: return (2.0 * a0 + 5.0 * a1) / 7.0;
      case 7u: return (1.0 * a0 + 6.0 * a1) / 7.0;
      default: return 0.0;
    }
  } else {
    switch (idx) {
      case 2u: return (4.0 * a0 + 1.0 * a1) / 5.0;
      case 3u: return (3.0 * a0 + 2.0 * a1) / 5.0;
      case 4u: return (2.0 * a0 + 3.0 * a1) / 5.0;
      case 5u: return (1.0 * a0 + 4.0 * a1) / 5.0;
      case 6u: return 0.0;
      case 7u: return 1.0;
      default: return 0.0;
    }
  }
}

void main() {
  ivec2 blockCoord = ivec2(gl_GlobalInvocationID.xy);

  if (all(lessThan(blockCoord, ivec2(u_info.extent)))) {
    uint blockOffset = uint(blockCoord.x) + uint(blockCoord.y) * u_info.extent.x;
    uint baseOffset = blockOffset * 4u;

    uint alphaBlockLo = texelFetch(src, int(baseOffset + 0u)).r;
    uint alphaBlockHi = texelFetch(src, int(baseOffset + 1u)).r;
    uint colorBlockLo = texelFetch(src, int(baseOffset + 2u)).r;
    uint colorBlockHi = texelFetch(src, int(baseOffset + 3u)).r;

    uint alpha0 = alphaBlockLo & 0xFFu;
    uint alpha1 = (alphaBlockLo >> 8) & 0xFFu;
    uint alphaBitsLo = alphaBlockLo >> 16;
    uint alphaBitsHi = alphaBlockHi;

    uint color0 = colorBlockLo & 0xFFFFu;
    uint color1 = colorBlockLo >> 16;
    uint selectors = colorBlockHi;

    ivec2 pixelBase = blockCoord * ivec2(4, 4) + u_info.dstOffset;
    ivec2 dstExtent = imageSize(dst);

    for (int y = 0; y < 4; y++) {
      for (int x = 0; x < 4; x++) {
        uint pixelIndex = uint(x + y * 4);
        uint selector = (selectors >> (pixelIndex * 2u)) & 0x3u;
        uint alphaIdx = decodeBc3AlphaIndex(pixelIndex, alphaBitsLo, alphaBitsHi);

        vec3 rgb = decodeBcColorOpaque(color0, color1, selector);
        float alpha = decodeBc3Alpha(alpha0, alpha1, alphaIdx);

        ivec2 pixelPos = pixelBase + ivec2(x, y);
        if (all(greaterThanEqual(pixelPos, ivec2(0)))
         && all(lessThan(pixelPos, dstExtent)))
          imageStore(dst, pixelPos, vec4(rgb, alpha));
      }
    }
  }
}
